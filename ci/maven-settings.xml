<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings used by the pipeline to publish to Nexus (story 014).
     No secret here: the credentials come from the Jenkins credential nexus-deploy-creds,
     exposed as environment variables by withCredentials only during the Publish stage. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
</settings>
